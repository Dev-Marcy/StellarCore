{
  "name": "stellarcore",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "test": "tsx scripts/run-tests.ts",
    "test:faults": "node --import tsx --test tests/faults/rateEngineFaults.test.ts tests/faults/reputationFaults.test.ts tests/faults/scheduledCycleFaults.test.ts",
    "audit:config": "node --import tsx scripts/audit-configuration.ts",
    "audit:compatibility": "node --import tsx scripts/audit-compatibility.ts",
    "audit:integrity": "node --import tsx scripts/audit-integrity.ts",
    "audit:sql": "node --import tsx scripts/audit-raw-sql.ts",
    "contract:update": "node --import tsx scripts/update-api-contracts.ts",
    "registry:print": "node --import tsx scripts/registry-print.ts",
    "registry:diff": "node --import tsx scripts/registry-diff.ts",
    "registry:reconcile": "tsx scripts/reconcile-registry.ts",
    "verify:sep10": "tsx scripts/verify-sep10.ts",
    "snapshot:rates": "tsx scripts/snapshot-rates.ts",
    "verify:latest-rates": "tsx scripts/verify-latest-rates.ts",
    "verify:reputation": "tsx scripts/verify-reputation.ts",
    "benchmark:latest-observations": "tsx scripts/benchmark-latest-observations.ts",
    "bootstrap:registry": "tsx scripts/bootstrap-registry.ts",
    "stamp:environment": "tsx scripts/stamp-database-environment.ts",
    "migration:gate": "node --import tsx scripts/migration-backup-gate.ts",
    "suppression:reactivate": "tsx scripts/reactivate-scheduled-source.ts",
    "release:manifest": "tsx scripts/release-cli.ts generate",
    "verify:release": "tsx scripts/release-cli.ts verify",
    "export:evidence": "tsx scripts/export-evidence.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "verify:install-reproducibility": "tsx scripts/verify-install-reproducibility.ts",
    "test:export": "node --import tsx --test tests/integration/export/evidence-package.test.ts",
    "test:csp": "node --import tsx --test tests/unit/security/browserHeaders.test.ts tests/unit/middleware/cspMiddleware.test.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stellar/stellar-sdk": "^17.0.0",
    "dotenv": "^17.4.2",
    "gsap": "^3.13.0",
    "ipaddr.js": "^2.2.0",
    "next": "^15.5.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "fast-check": "^3.23.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0"
  }
